      "AppFunctionStaticMetadata-com.cercafunctions.app": {
        "serviceName": [
          "com.cercafunctions.appfunctions.JourneyAppFunctionService"
        ],
        "description": [
          "Queries the habitual journey's station arrival and qualitative railway context for an explicit departure.\nReference uses the saved duration and is not an operational forecast. Explicit demos retain their fixed\njourney, date and clock. Sharing must be authorized in the app; calendar and contact data are excluded."
        ],
        "accessLevel": [
          "androidTrusted"
        ],
        "isCompatEnforcementEnabled": [
          true
        ],
        "response": [
          {
            "description": [
              "Arrival evidence and bounded railway summary, including source and observation times. Null arrival\/delay are unknown."
            ],
            "valueType": [
              {
                "dataTypeReference": [
                  "com.cercafunctions.appfunctions.JourneyResponse"
                ],
                "type": [
                  11
                ],
                "isNullable": [
                  false
                ]
              }
            ]
          }
        ],
        "enabledByDefault": [
          false
        ],
        "functionId": [
          "com.cercafunctions.appfunctions.BaseJourneyAppFunctionService#queryJourney"
        ],
        "packageNameHash": [
          725150957
        ],
        "scope": [
          "global"
        ],
        "parameters": [
          {
            "description": [
              "Local departure date and time. A past reference or nonexistent\/ambiguous unresolved time is invalid."
            ],
            "isRequired": [
              true
            ],
            "name": [
              "departure"
            ],
            "dataTypeMetadata": [
              {
                "dataTypeReference": [
                  "java.time.LocalDateTime"
                ],
                "type": [
                  11
                ],
                "isNullable": [
                  false
                ]
              }
            ]
          },
          {
            "description": [
              "IANA or fixed-offset zone for departure; no implicit device-zone default."
            ],
            "isRequired": [
              true
            ],
            "name": [
              "zone"
            ],
            "dataTypeMetadata": [
              {
                "dataTypeReference": [
                  "java.time.ZoneId"
                ],
                "type": [
                  11
                ],
                "isNullable": [
                  false
                ]
              }
            ]
          },
          {
            "description": [
              "Null selects REFERENCE. Other exact values: DEMO_NORMAL, DEMO_DELAYED, DEMO_UNKNOWN."
            ],
            "isRequired": [
              false
            ],
